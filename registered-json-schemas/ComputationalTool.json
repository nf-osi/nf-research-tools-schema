{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-prod.prod.sagebase.org/repo/v1/schema/type/registered/org.synapse.nf-researchToolsComputationalTool",
  "title": "NF Research Tools - Computational Tool",
  "description": "Computational tools including software and analysis pipelines used in NF research.",
  "type": "object",
  "properties": {
    "aiSummary": {
      "description": "A large language model-generated summary of the resource.",
      "type": "string"
    },
    "analyticalPlatformSupport": {
      "description": "Experimental data types or analytical platforms this tool is designed to process or integrate.",
      "items": {
        "type": "string",
        "enum": [
          "Mass spectrometry / proteomics",
          "Metabolomics",
          "RNA-seq / transcriptomics",
          "Whole genome / exome sequencing",
          "Single-cell RNA-seq",
          "Imaging / pathology",
          "Pharmacokinetics / PK modeling",
          "Pharmacodynamics / PD modeling",
          "Clinical / EHR data",
          "Other"
        ]
      },
      "type": "array"
    },
    "availability": {
      "type": "string",
      "enum": [
        "Vendor",
        "Contact Developer",
        "Freely Available",
        "Unknown"
      ],
      "description": "How this resource can be obtained."
    },
    "containerized": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Unknown"
      ],
      "description": "Whether containerized versions (Docker, Singularity) are available."
    },
    "dateAdded": {
      "description": "The date that the resource was originally added.",
      "format": "date",
      "type": "string"
    },
    "dateModified": {
      "description": "The last update of the resource metadata.",
      "format": "date",
      "type": "string"
    },
    "dependencies": {
      "description": "Key software dependencies or requirements.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "description": "Free text description, summary, or purpose of the resource.",
      "type": "string"
    },
    "documentation": {
      "description": "URL to documentation or user manual.",
      "format": "uri",
      "type": "string"
    },
    "downloadURL": {
      "description": "A URL to download the tool or access its repository.",
      "format": "uri",
      "type": "string"
    },
    "geneticDisorder": {
      "description": "Genetic disorders associated with the resource.",
      "items": {
        "type": "string",
        "enum": [
          "Neurofibromatosis type 1",
          "Neurofibromatosis type 2",
          "Schwannomatosis",
          "NF1 Spontaneous Mutation",
          "No known genetic disorder",
          "Other"
        ]
      },
      "type": "array"
    },
    "howToAcquire": {
      "description": "How to acquire a particular resource.",
      "type": "string"
    },
    "lastUpdate": {
      "description": "Date of last software update or release.",
      "format": "date",
      "type": "string"
    },
    "licenseDetails": {
      "description": "Free-text clarification for non-standard licenses (e.g. non-commercial clauses, third-party tool requirements, or contact info for commercial use). Most relevant when licenseType is \"Other\" or \"Proprietary\".",
      "type": "string"
    },
    "licenseType": {
      "type": "string",
      "enum": [
        "MIT",
        "Apache 2.0",
        "GPL",
        "BSD",
        "Creative Commons",
        "Proprietary",
        "Other",
        "Unknown"
      ],
      "description": "Software license type."
    },
    "maintainer": {
      "description": "Name or organization maintaining the software.",
      "type": "string"
    },
    "manifestation": {
      "description": "Manifestations or symptoms that this resource is used to model (e.g. tumor type, behavioral phenotype).",
      "items": {
        "type": "string",
        "enum": [
          "Acute Lymphocytic Leukemia",
          "Acute Myeloid Leukemia",
          "Adult T Acute Lymphoblastic Leukemia",
          "Amelanotic Cutaneous Melanoma",
          "Askin Tumor",
          "Astrocytoma",
          "Astrogliosis",
          "Atypical Neurofibroma",
          "BCR-ABL1 positive",
          "BRCA2 Syndrome",
          "Brain NOS",
          "Cafe-Au-Lait Spots",
          "Canine Histiocytic Sarcoma",
          "Canine Lymphoma",
          "Canine Melanoma",
          "Canine Soft Tissue Sarcoma",
          "Cecum Adenocarcinoma",
          "Cervical Adenocarcinoma",
          "Chronic Myelogenous Leukemia",
          "Clinically Affected",
          "Clinically Asymptomatic (Self-reported)",
          "Clinically Asymptomatic But At Risk",
          "Cognition",
          "Colon Adenocarcinoma",
          "Colon Carcinoma",
          "Cutaneous Melanoma",
          "Cutaneous Neurofibroma",
          "Cystic Fibrosis",
          "Diffuse Infiltrating Neurofibroma",
          "Embryonic Lethal",
          "General NF1 Deficiency",
          "Glioblastoma",
          "Growth",
          "Heart Malformation",
          "Hereditary Breast and Ovarian Cancer Syndrome",
          "High Grade Glioma",
          "Human Papillomavirus-Related Endocervical Adenocarcinoma",
          "Invasive Breast Carcinoma",
          "Juvenile Myelomonocytic Leukemia",
          "Lipoma",
          "Low Grade Glioma",
          "Lung Adenocarcinoma",
          "Lung Adenosquamous Carcinoma",
          "Lung Carcinoid Tumor",
          "Lung Giant Cell Carcinoma",
          "Lung Large Cell Carcinoma",
          "Lung Non-Small Cell Carcinoma",
          "Lung Papillary Adenocarcinoma",
          "Lung Small Cell Carcinoma",
          "Lung Squamous Cell Carcinoma",
          "Malignant Peripheral Nerve Sheath Tumor",
          "Melanoma",
          "Meningioma",
          "Metabolic Function",
          "Mild Or No Symptoms",
          "Minimally Invasive Lung Adenocarcinoma",
          "Mouse Adrenal Gland Pheochromocytoma",
          "Neural Crest Hyperplasia",
          "Neuroblastoma",
          "Neurofibroma",
          "Neurofibroma NOS",
          "Neurofibromatosis Type 1 (NF1)-Like Syndrome (NFLS)",
          "No Symptoms",
          "None",
          "Noonan Syndrome",
          "Optic Nerve Glioma",
          "Other",
          "Ovarian Cystadenocarcinoma",
          "Pancreatic Adenocarcinoma",
          "Pancreatic Adenosquamous Carcinoma",
          "Pancreatic Carcinoma",
          "Pancreatic Ductal Adenocarcinoma",
          "Pancreatic Somatostatinoma",
          "Pheochromocytoma",
          "Pleural Malignant Mesothelioma",
          "Plexiform Neurofibroma",
          "Poorly Differentiated Thyroid Gland Carcinoma",
          "Rectal Adenocarcinoma",
          "Schwannoma",
          "Spinal Development",
          "Thyroid Gland Anaplastic Carcinoma",
          "Thyroid Gland Follicular Carcinoma",
          "Unaffected Nerve"
        ]
      },
      "type": "array"
    },
    "programmingLanguage": {
      "description": "Primary programming language(s) used.",
      "items": {
        "type": "string",
        "enum": [
          "Python",
          "R",
          "Java",
          "C++",
          "MATLAB",
          "Julia",
          "Perl",
          "Shell Script",
          "JavaScript",
          "Other"
        ]
      },
      "type": "array"
    },
    "resourceId": {
      "description": "A unique identifier for the resource.",
      "type": "string"
    },
    "resourceName": {
      "description": "The canonical name of the resource.",
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "Animal Model",
        "Cell Line",
        "Antibody",
        "Genetic Reagent",
        "Biobank",
        "Computational Tool",
        "Organoid Protocol",
        "Patient-Derived Model",
        "Clinical Assessment Tool"
      ],
      "description": "Type of resource."
    },
    "rrid": {
      "description": "The RRID, a standard resource identifier for interoperability with other databases. Must include the lowercase 'rrid:' prefix.",
      "pattern": "^rrid:[a-zA-Z]+.+$",
      "type": "string"
    },
    "softwareName": {
      "description": "The name of the software or computational tool.",
      "type": "string"
    },
    "softwareType": {
      "type": "string",
      "enum": [
        "Analysis Software",
        "Pipeline",
        "Package/Library",
        "Workflow",
        "Database",
        "Web Application",
        "Command-line Tool",
        "Plugin",
        "Other"
      ],
      "description": "Type of computational tool."
    },
    "softwareVersion": {
      "description": "Version number or identifier of the software.",
      "type": "string"
    },
    "sourceRepository": {
      "description": "URL to source code repository (e.g. GitHub, GitLab).",
      "format": "uri",
      "type": "string"
    },
    "synonyms": {
      "description": "Synonyms of the resource.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "systemRequirements": {
      "description": "System requirements (OS, memory, compute).",
      "type": "string"
    },
    "usageRequirements": {
      "description": "Any known restrictions on use of the resource.",
      "items": {
        "type": "string",
        "enum": [
          "data sharing required",
          "non-commercial use only",
          "re-distribution not permitted",
          "generation of germ line transmitting chimeras not permitted",
          "creation of functional gametes not permitted",
          "generation of interspecies chimeras not permitted",
          "human cloning not permitted",
          "cannot be used for treatment purposes",
          "IRB documentation required",
          "special licencing restrictions (see vendor for more information)",
          "unknown"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "softwareName",
    "softwareType",
    "resourceId",
    "resourceName",
    "resourceType",
    "availability",
    "dateAdded",
    "dateModified"
  ],
  "additionalProperties": {}
}
