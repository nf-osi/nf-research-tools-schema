{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-prod.prod.sagebase.org/repo/v1/schema/type/registered/org.synapse.nf-researchToolsOrganoidProtocol",
  "title": "NF Research Tools - Organoid Protocol",
  "description": "Advanced 3D cellular models including organoids, assembloids, spheroids, and other 3D culture systems.",
  "type": "object",
  "properties": {
    "aiSummary": {
      "description": "A large language model-generated summary of the resource.",
      "type": "string"
    },
    "cellTypes": {
      "description": "Cell types present in the model.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "characterizationMethods": {
      "description": "Methods used to characterize the model.",
      "items": {
        "type": "string",
        "enum": [
          "Immunofluorescence",
          "RNA-seq",
          "scRNA-seq",
          "Electrophysiology",
          "Imaging",
          "Other"
        ]
      },
      "type": "array"
    },
    "cryopreservationProtocol": {
      "description": "Protocol for freezing/thawing, if available.",
      "type": "string"
    },
    "cultureSystem": {
      "type": "string",
      "enum": [
        "Static",
        "Spinning Bioreactor",
        "Microfluidic",
        "Air-Liquid Interface",
        "Other"
      ],
      "description": "Culture system used for maintenance."
    },
    "dateAdded": {
      "description": "The date that the resource was originally added.",
      "format": "date",
      "type": "string"
    },
    "dateModified": {
      "description": "The last update of the resource metadata.",
      "format": "date",
      "type": "string"
    },
    "derivationSource": {
      "type": "string",
      "enum": [
        "iPSC",
        "ESC",
        "Primary Tissue",
        "Cell Line",
        "Patient-Derived",
        "Other"
      ],
      "description": "Source of cells used to generate the model."
    },
    "description": {
      "description": "Free text description, summary, or purpose of the resource.",
      "type": "string"
    },
    "howToAcquire": {
      "description": "How to acquire a particular resource.",
      "type": "string"
    },
    "matrixType": {
      "type": "string",
      "enum": [
        "Matrigel",
        "BME",
        "Hydrogel",
        "Synthetic Matrix",
        "Scaffold-Free",
        "Other"
      ],
      "description": "Extracellular matrix or scaffold used."
    },
    "maturationTime": {
      "description": "Time required for model maturation.",
      "type": "string"
    },
    "modelType": {
      "type": "string",
      "enum": [
        "Organoid",
        "Assembloid",
        "Spheroid",
        "3D Culture",
        "Other"
      ],
      "description": "Type of 3D cellular model."
    },
    "organoidType": {
      "type": "string",
      "enum": [
        "Cerebral",
        "Intestinal",
        "Liver",
        "Kidney",
        "Cardiac",
        "Retinal",
        "Lung",
        "Pancreatic",
        "Other"
      ],
      "description": "Specific type of organoid, if applicable."
    },
    "passageNumber": {
      "description": "Current passage number, if applicable.",
      "type": "string"
    },
    "qualityControlMetrics": {
      "description": "Quality control metrics used.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resourceId": {
      "description": "A unique identifier for the resource.",
      "type": "string"
    },
    "resourceName": {
      "description": "The canonical name of the resource.",
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "Animal Model",
        "Cell Line",
        "Antibody",
        "Genetic Reagent",
        "Biobank",
        "Computational Tool",
        "Organoid Protocol",
        "Patient-Derived Model",
        "Clinical Assessment Tool"
      ],
      "description": "Type of resource."
    },
    "rrid": {
      "description": "The RRID, a standard resource identifier for interoperability with other databases. Must include the lowercase 'rrid:' prefix.",
      "pattern": "^rrid:[a-zA-Z]+.+$",
      "type": "string"
    },
    "synonyms": {
      "description": "Synonyms of the resource.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "usageRequirements": {
      "description": "Any known restrictions on use of the resource.",
      "items": {
        "type": "string",
        "enum": [
          "data sharing required",
          "non-commercial use only",
          "re-distribution not permitted",
          "generation of germ line transmitting chimeras not permitted",
          "creation of functional gametes not permitted",
          "generation of interspecies chimeras not permitted",
          "human cloning not permitted",
          "cannot be used for treatment purposes",
          "IRB documentation required",
          "special licencing restrictions (see vendor for more information)",
          "unknown"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "modelType",
    "derivationSource",
    "cellTypes",
    "resourceId",
    "resourceName",
    "resourceType",
    "howToAcquire",
    "dateAdded",
    "dateModified"
  ],
  "additionalProperties": {}
}
