{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-prod.prod.sagebase.org/repo/v1/schema/type/registered/org.synapse.nf-researchToolsPatientDerivedModel",
  "title": "NF Research Tools - Patient Derived Model",
  "description": "Patient-derived models including patient-derived xenografts (PDX), humanized mice, patient-derived organoids, and patient-derived cell lines.",
  "type": "object",
  "properties": {
    "aiSummary": {
      "description": "A large language model-generated summary of the resource.",
      "type": "string"
    },
    "bbbIntegrityStatus": {
      "type": "string",
      "enum": [
        "Intact",
        "Compromised",
        "Not Applicable",
        "Unknown"
      ]
    },
    "clinicalData": {
      "description": "Available clinical data from the patient.",
      "type": "string"
    },
    "clinicalTranslationHistory": {
      "description": "Known instances where findings from this model did or did not translate to human clinical outcomes.",
      "type": "string"
    },
    "dateAdded": {
      "description": "The date that the resource was originally added.",
      "format": "date",
      "type": "string"
    },
    "dateModified": {
      "description": "The last update of the resource metadata.",
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Free text description, summary, or purpose of the resource.",
      "type": "string"
    },
    "engraftmentSite": {
      "type": "string",
      "enum": [
        "Subcutaneous",
        "Orthotopic",
        "Intracranial",
        "Mammary Fat Pad",
        "Other"
      ],
      "description": "Site of engraftment in host organism."
    },
    "establishmentRate": {
      "description": "Success rate of model establishment.",
      "type": "string"
    },
    "hostStrain": {
      "type": "string",
      "enum": [
        "NSG",
        "NOD-SCID",
        "nude",
        "SCID",
        "Other"
      ],
      "description": "Host organism strain for xenografts."
    },
    "howToAcquire": {
      "description": "How to acquire a particular resource.",
      "type": "string"
    },
    "mechanismOfActionValidation": {
      "description": "Drug mechanisms of action that have been successfully tested in this model.",
      "items": {
        "type": "string",
        "enum": [
          "MEK inhibitors",
          "RAS pathway (non-MEK)",
          "mTOR inhibitors",
          "VEGF/angiogenesis",
          "CDK inhibitors",
          "HDAC inhibitors",
          "Other kinase inhibitors",
          "Immunotherapy",
          "Chemotherapy",
          "Other"
        ]
      },
      "type": "array"
    },
    "modelLimitations": {
      "description": "Explicit description of what this model does NOT recapitulate or where it may produce false positive/negative results.",
      "type": "string"
    },
    "modelSystemType": {
      "type": "string",
      "enum": [
        "PDX (Patient-Derived Xenograft)",
        "Humanized Mouse",
        "Patient-Derived Organoid",
        "Patient-Derived Cell Line",
        "Other"
      ],
      "description": "Type of patient-derived model system."
    },
    "molecularCharacterization": {
      "description": "Molecular characterization performed.",
      "items": {
        "type": "string",
        "enum": [
          "Genomic Sequencing",
          "RNA-seq",
          "Proteomics",
          "Immunohistochemistry",
          "Flow Cytometry",
          "Methylation",
          "Other"
        ]
      },
      "type": "array"
    },
    "mtaRequired": {
      "description": "Whether a Material Transfer Agreement is required to access this model.",
      "type": "boolean"
    },
    "nfGeneticDisorder": {
      "type": "string",
      "enum": [
        "Neurofibromatosis Type 1",
        "Neurofibromatosis Type 2",
        "Schwannomatosis",
        "NF1 Spontaneous Mutation",
        "None"
      ],
      "description": "NF genetic disorder this model is used to study."
    },
    "ngnriRepositoryStatus": {
      "description": "Whether this model is deposited in the Nick Gilbert Neurofibromatosis Research Institute (NGNRI) repository for equitable access.",
      "type": "boolean"
    },
    "organ": {
      "type": "string",
      "enum": [
        "Adrenal Gland",
        "Biliary Tract",
        "Bladder",
        "Blood",
        "Bone Marrow",
        "Brain",
        "Breast",
        "Bronchial Tree",
        "Cervix",
        "Colon",
        "Duct",
        "Epididymis",
        "Esophagus",
        "Fallopian Tube",
        "Gallbladder",
        "Gland",
        "Gonad",
        "Heart",
        "Intestine",
        "Kidney",
        "Liver",
        "Lung",
        "Lymph Node",
        "Nerve",
        "Ear",
        "Eye",
        "Nose",
        "Tongue",
        "Ovary",
        "Pancreas",
        "Penis",
        "Peripheral Nervous System",
        "Prostate",
        "Seminal Vesicle",
        "Skin",
        "Spermatic Cord",
        "Spinal Cord",
        "Spleen",
        "Stomach",
        "Thymus Gland",
        "Thyroid Gland",
        "Tonsil",
        "Trachea",
        "Tracheobronchial Tree",
        "Ureter",
        "Urethra",
        "Uterus",
        "Vagina",
        "Vulva",
        "Other"
      ],
      "description": "The organ the patient-derived model is derived from."
    },
    "otherMechanismOfActionValidation": {
      "description": "Free-text specification when mechanismOfActionValidation includes \"Other\".",
      "type": "string"
    },
    "otherRouteOfAdministration": {
      "description": "Free-text specification when routeOfAdministration includes \"Other\".",
      "type": "string"
    },
    "passageNumber": {
      "description": "Current passage number, if applicable.",
      "type": "string"
    },
    "patientDiagnosis": {
      "description": "Original patient diagnosis or condition.",
      "type": "string"
    },
    "pediatricSuitability": {
      "type": "string",
      "enum": [
        "Pediatric",
        "Adult",
        "Both",
        "Unknown"
      ],
      "description": "Whether this model is suitable for studying pediatric, adult, or both age groups."
    },
    "pkpdCapabilities": {
      "description": "Pharmacokinetic and pharmacodynamic measurements that can be performed in this model.",
      "items": {
        "type": "string",
        "enum": [
          "Drug concentration in plasma",
          "Drug concentration in brain/CNS tissue",
          "Drug concentration in tumor",
          "Drug concentration in CSF",
          "Target engagement measurement",
          "Pathway modulation (e.g., pERK, pAKT)",
          "Biomarker response",
          "Metabolite profiling",
          "Metabolic pathway flux analysis",
          "Drug-drug interaction assessment",
          "Other"
        ]
      },
      "type": "array"
    },
    "regulatoryAcceptanceHistory": {
      "description": "Known FDA/EMA precedents where data from this model type supported a regulatory submission or approval.",
      "type": "string"
    },
    "resourceId": {
      "description": "A unique identifier for the resource.",
      "type": "string"
    },
    "resourceName": {
      "description": "The canonical name of the resource.",
      "type": "string"
    },
    "resourceType": {
      "type": "string",
      "enum": [
        "Animal Model",
        "Cell Line",
        "Antibody",
        "Genetic Reagent",
        "Biobank",
        "Computational Tool",
        "Organoid Protocol",
        "Patient-Derived Model",
        "Clinical Assessment Tool"
      ],
      "description": "Type of resource."
    },
    "routeOfAdministration": {
      "description": "Drug delivery routes that have been validated or are feasible in this model.",
      "items": {
        "type": "string",
        "enum": [
          "Oral",
          "Intravenous (IV)",
          "Intraperitoneal (IP)",
          "Intracranial",
          "Subcutaneous",
          "Topical",
          "Intranasal",
          "Other"
        ]
      },
      "type": "array"
    },
    "rrid": {
      "description": "The RRID, a standard resource identifier for interoperability with other databases. Must include the lowercase 'rrid:' prefix.",
      "pattern": "^rrid:[a-zA-Z]+.+$",
      "type": "string"
    },
    "synonyms": {
      "description": "Synonyms of the resource.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "timelineToResults": {
      "type": "string",
      "enum": [
        "Less than 1 month",
        "1–3 months",
        "3–6 months",
        "6–12 months",
        "More than 12 months",
        "Unknown"
      ],
      "description": "Estimated time from experiment start to primary endpoint readout."
    },
    "tumorType": {
      "description": "Tumor types associated with the resource.",
      "items": {
        "type": "string",
        "enum": [
          "cutaneous neurofibroma",
          "plexiform neurofibroma",
          "atypical neurofibroma",
          "schwannoma",
          "meningioma",
          "malignant peripheral nerve sheath tumor",
          "low grade glioma",
          "high grade glioma",
          "pheochromocytoma",
          "optic nerve glioma",
          "neurofibroma NOS",
          "diffuse infiltrating neurofibroma",
          "brain NOS",
          "Other"
        ]
      },
      "type": "array"
    },
    "usageRequirements": {
      "description": "Any known restrictions on use of the resource.",
      "items": {
        "type": "string",
        "enum": [
          "data sharing required",
          "non-commercial use only",
          "re-distribution not permitted",
          "generation of germ line transmitting chimeras not permitted",
          "creation of functional gametes not permitted",
          "generation of interspecies chimeras not permitted",
          "human cloning not permitted",
          "cannot be used for treatment purposes",
          "IRB documentation required",
          "special licencing restrictions (see vendor for more information)",
          "unknown"
        ]
      },
      "type": "array"
    },
    "validationMethods": {
      "description": "Methods used to validate model fidelity to patient.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "modelSystemType",
    "patientDiagnosis",
    "resourceId",
    "resourceName",
    "resourceType",
    "howToAcquire",
    "dateAdded",
    "dateModified"
  ],
  "additionalProperties": {}
}
