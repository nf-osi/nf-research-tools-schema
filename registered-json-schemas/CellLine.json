      "description": "Synonyms of the resource.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tissue": {
      "type": "string",
      "enum": [
        "Blood",
        "Bone marrow",
        "Buccal mucosa",
        "Buffy coat",
        "Cerebral cortex",
        "Dorsal root ganglion",
        "Embryonic tissue",
        "Meninges",
        "Nerve tissue",
        "Optic nerve",
        "Plasma",
        "Primary tumor",
        "Sciatic nerve",
        "Serum",
        "Splenocyte",
        "Unspecified",
        "Urine",
        "Whole brain"
      ],
