{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repo-prod.prod.sagebase.org/repo/v1/schema/type/registered/org.synapse.nf-researchToolsCellLine",
  "title": "NF Research Tools - Cell Line",
  "description": "A cell culture selected for uniformity from a cell population derived from a usually homogeneous tissue source.",
  "type": "object",
  "properties": {
    "aiSummary": {
      "description": "A large language model-generated summary of the resource.",
      "type": "string"
    },
    "cellLineCategory": {
      "type": "string",
      "enum": [
        "Cancer cell line",
        "Conditionally immortalized cell line",
        "Embryonic stem cell",
        "Factor-dependent cell line",
        "Finite cell line",
        "Hybridoma",
        "Hybrid cell line",
        "Induced pluripotent stem cell",
        "Somatic stem cell",
        "Spontaneously immortalized cell line",
        "Stromal cell line",
        "Telomerase immortalized cell line",
        "Transformed cell line",
        "Undefined cell line type"
      ],
      "description": "The category to which the cell line belongs."
    },
    "cultureMedia": {
      "description": "The base culture medium and supplements used to maintain the cell line (e.g. RPMI supplemented with 10% FBS).",
      "type": "string"
    },
    "dateAdded": {
      "description": "The date that the resource was originally added.",
      "format": "date",
      "type": "string"
    },
    "dateModified": {
      "description": "The last update of the resource metadata.",
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Free text description, summary, or purpose of the resource.",
      "type": "string"
    },
    "donor": {
      "description": "Foreign key to Donor (donorId). The biological donor from which the resource was derived.",
      "type": "string"
    },
    "geneticDisorder": {
      "description": "Genetic disorders associated with the resource.",
      "items": {
        "type": "string",
        "enum": [
          "Neurofibromatosis type 1",
          "Neurofibromatosis type 2",
          "Schwannomatosis",
          "No known genetic disorder"
        ]
      },
      "type": "array"
    },
    "howToAcquire": {
      "description": "How to acquire a particular resource.",
      "type": "string"
    },
    "manifestation": {
      "description": "Manifestations or symptoms that this resource is used to model (e.g. tumor type, behavioral phenotype).",
      "items": {
        "type": "string",
        "enum": [
          "Acute Lymphocytic Leukemia",
          "Adult T Acute Lymphoblastic Leukemia",
          "Amelanotic Cutaneous Melanoma",
          "Askin Tumor",
          "Astrocytoma",
