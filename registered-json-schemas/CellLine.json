        "Thymus Gland",
        "Thyroid Gland",
        "Tonsil",
        "Trachea",
        "Tracheobronchial Tree",
        "Ureter",
        "Urethra",
        "Uterus",
        "Vagina",
        "Vulva",
        "Other"
